# AI Model Provider: GEMINI, OLLAMA, or OPENAI
LLM_PROVIDER=GEMINI

# Required if LLM_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here

# Required if LLM_PROVIDER=OPENAI
OPENAI_API_KEY=your_openai_api_key_here

# Fallback Mechanism: Set to true to automatically fallback to Ollama if cloud LLM fails
ENABLE_FALLBACK=true

# (Optional) If using Ollama or fallback, ensure Ollama is running locally on port 11434.
