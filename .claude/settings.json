{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/hooks/guard-git.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".ai/hooks/guard-pr-body.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "mcp__.*__pull_request_create",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/hooks/guard-pr-body.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
